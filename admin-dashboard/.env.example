# Admin Dashboard - Java (replaces Medusa dashboard)
# Copy to .env and set values (or use env vars).

# Port (default 9010)
# SERVER_PORT=9010

# Admin RBAC - required for login
ADMIN_RBAC_SERVICE_URL=http://localhost:8088

# JWT secret — must match admin-rbac-service (use same value as ADMIN_JWT_SECRET or JWT_SECRET there)
JWT_SECRET=43c165c91c29d4762ea3e3171056e933d65fc7381a3cf8036f7a126cebf3e1fb
# ADMIN_JWT_SECRET=...  # alternative env name; dashboard reads JWT_SECRET first, then ADMIN_JWT_SECRET

# Optional: microservices for catalog and regions
PRODUCTS_SERVICE_URL=http://localhost:8082
# products-service / search-service use CATALOG_* and ADMIN_API_BASE_URL (not MEDUSA_*). Examples: repo deploy/examples/*.yaml, products-service/.env.example
REGIONS_SERVICE_URL=http://localhost:8084
CATEGORIES_SERVICE_URL=http://localhost:8083
COLLECTIONS_SERVICE_URL=http://localhost:8086

# Optional: global admin search aggregator service
SEARCH_SERVICE_URL=http://localhost:8081
