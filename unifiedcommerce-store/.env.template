STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
# Database: GCP Cloud SQL (this project uses Cloud SQL, not Supabase).
# Local: start Cloud SQL Proxy (see deploy/refresh-supabase-from-cloudsql.sh for proxy), then set e.g. DATABASE_URL=postgresql://medusa_app:PASSWORD@127.0.0.1:5434/postgres
# Deployed: set DATABASE_URL to your Cloud SQL connection (e.g. /cloudsql/PROJECT:REGION:INSTANCE or private IP).
DATABASE_URL=
DB_NAME=medusa-v2

# Enable Role-Based Access Control (RBAC). Keep true; fix "Insufficient permissions" by assigning roles/policies, not by disabling RBAC.
MEDUSA_FF_RBAC=true

# Catalog reads are not served by Medusa (410): /store/products*, /store/product-variants*,
# /store/product-categories*, /store/collections*. Admin product search returns 410 — use Java from the backoffice.

# SendGrid (for invite emails and customer password reset emails)
# SENDGRID_API_KEY=SG.xxx
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Algolia (search). Never commit real keys; set in .env locally only.
# ALGOLIA_APP_ID=
# ALGOLIA_ADMIN_API_KEY=
# ALGOLIA_SEARCH_API_KEY=

# Storefront URL for password reset links (customer forgot password email)
# MEDUSA_STOREFRONT_URL=http://localhost:8000
# Admin URL for invite links (optional)
# MEDUSA_ADMIN_URL=http://localhost:9000

# GCP/Cloud: when admin UI is on a different origin than the API:
# 1. Set MEDUSA_BACKEND_URL at build time or window.__MEDUSA_BACKEND_URL__ so admin can call the API.
# 2. Add the admin origin to ADMIN_CORS and AUTH_CORS (e.g. https://admin-xxx.run.app).
# MEDUSA_BACKEND_URL=https://your-backend.run.app

# Auth debug: log login and password reset to console (set to false to disable)
# DEBUG_AUTH=true
