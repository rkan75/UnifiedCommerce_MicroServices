# Backend API base (admin + auth). Pick one stack:
#
# Java admin-dashboard + admin-rbac (default Vite proxy target is http://localhost:9010):
# VITE_MEDUSA_BACKEND_URL=http://localhost:9010
#
# Medusa Node backend (port 9000):
# VITE_MEDUSA_BACKEND_URL=http://localhost:9000
#
# Dev: leave unset to use relative /admin and /auth — Vite proxies to localhost:9010 by default (see vite.config.ts).

# Java products-service (required for substitution search on pick order)
# VITE_PRODUCTS_SERVICE_URL=http://localhost:8082
# Optional: priced variants in search (your Medusa/Java region id, e.g. reg_...)
# VITE_PRODUCTS_SEARCH_REGION_ID=
