# Copy to .env for local dev (restart-dev.sh loads .env automatically).
# In Kubernetes / Docker / CI: set the same keys on the container.
#
# --- Renamed from legacy ---
# MEDUSA_PRODUCT_TABLE / MEDUSA_VARIANT_TABLE / MEDUSA_PRODUCT_CATEGORY_* → CATALOG_* (same names as products-service)
# MEDUSA_ADMIN_URL → ADMIN_API_BASE_URL (host for federated /admin/search targets that share one base URL)

# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/dbname
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# SERVER_PORT=8081

# CATALOG_PRODUCT_TABLE=product
# CATALOG_VARIANT_TABLE=product_variant
# CATALOG_PRODUCT_CATEGORY_LINK_TABLE=product_category_product
# CATALOG_PRODUCT_CATEGORY_LINK_CATEGORY_COLUMN=product_category_id

# Default host for admin-search targets (products, categories, regions, …) in application.yml
# Use Java admin-dashboard when it proxies /admin/*, e.g. http://admin-dashboard:9010
# ADMIN_API_BASE_URL=http://localhost:9010

# Optional per-target overrides (see search-service/src/main/resources/application.yml)
# ADMIN_RBAC_SERVICE_URL=http://localhost:8088
# ORDER_SERVICE_URL=
# INVENTORY_SERVICE_URL=
# ADMIN_SEARCH_DEFAULT_LIMIT=10
# ADMIN_SEARCH_TIMEOUT_MS=4000
