# Copy to deploy/.env and set values. Used by build-and-deploy-all.sh
# DATABASE_URL is required only when deploying the backend (Medusa API + Admin).

# Production Postgres (e.g. Cloud SQL).
# Option A - Cloud SQL Auth Proxy (recommended; no authorized networks needed):
#   CLOUD_SQL_INSTANCE=PROJECT_ID:REGION:INSTANCE_NAME
#   DATABASE_URL=postgresql://user:password@/dbname?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
# Option B - Public IP (requires Cloud SQL → Connections → Authorized networks → add 0.0.0.0/0):
#   DATABASE_URL=postgresql://user:password@PUBLIC_IP:5432/dbname
# Option C - Private IP (requires VPC connector; see deploy/CLOUD-SQL-PRIVATE-IP-VPC-GUIDE.md):
#   DATABASE_URL=postgresql://user:password@10.x.x.x:5432/dbname
#   VPC_CONNECTOR=medusa-vpc-conn
#   VPC_EGRESS=all-traffic
DATABASE_URL=
# CLOUD_SQL_INSTANCE=unifiedcommerce-487215:us-central1:YOUR_INSTANCE_NAME
# VPC_CONNECTOR=medusa-vpc-conn
# VPC_EGRESS=all-traffic
