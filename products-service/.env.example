# Copy to .env for local dev (restart-dev.sh loads .env automatically).
# In Kubernetes / Docker / CI: set the same keys on the container (ConfigMap + Secret).
#
# --- Renamed from legacy (use CATALOG_* / CATALOG_DEFAULT_PRODUCT_TYPE_ID only) ---
# MEDUSA_PRODUCT_TABLE              → CATALOG_PRODUCT_TABLE
# MEDUSA_VARIANT_TABLE              → CATALOG_VARIANT_TABLE
# MEDUSA_REGION_TABLE               → CATALOG_REGION_TABLE
# MEDUSA_PRODUCT_CATEGORY_TABLE     → CATALOG_PRODUCT_CATEGORY_TABLE
# MEDUSA_PRODUCT_CATEGORY_LINK_TABLE → CATALOG_PRODUCT_CATEGORY_LINK_TABLE
# MEDUSA_PRODUCT_CATEGORY_LINK_CATEGORY_COLUMN → CATALOG_PRODUCT_CATEGORY_LINK_CATEGORY_COLUMN
# MEDUSA_PRODUCT_TYPE_TABLE         → CATALOG_PRODUCT_TYPE_TABLE
# STOREFRONT_PRODUCT_TYPE_ID        → CATALOG_DEFAULT_PRODUCT_TYPE_ID
# MEDUSA_PRODUCT_SALES_CHANNEL_LINK_TABLE → CATALOG_PRODUCT_SALES_CHANNEL_LINK_TABLE
# MEDUSA_SALES_CHANNEL_TABLE        → CATALOG_SALES_CHANNEL_TABLE
# MEDUSA_PRODUCT_TAG_LINK_TABLE     → CATALOG_PRODUCT_TAG_LINK_TABLE
# MEDUSA_PRODUCT_TAG_TABLE          → CATALOG_PRODUCT_TAG_TABLE
# MEDUSA_PRODUCT_TAG_ID_COLUMN      → CATALOG_PRODUCT_TAG_ID_COLUMN
# MEDUSA_PRODUCT_TAG_VALUE_COLUMN   → CATALOG_PRODUCT_TAG_VALUE_COLUMN
# MEDUSA_PRODUCT_TAG_LINK_PRODUCT_COLUMN → CATALOG_PRODUCT_TAG_LINK_PRODUCT_COLUMN
# MEDUSA_PRODUCT_TAG_LINK_TAG_COLUMN → CATALOG_PRODUCT_TAG_LINK_TAG_COLUMN

# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/dbname
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# SERVER_PORT=8082

# CATALOG_PRODUCT_TABLE=product
# CATALOG_VARIANT_TABLE=product_variant
# CATALOG_REGION_TABLE=region
# CATALOG_PRODUCT_CATEGORY_TABLE=product_category
# CATALOG_PRODUCT_CATEGORY_LINK_TABLE=product_category_product
# CATALOG_PRODUCT_CATEGORY_LINK_CATEGORY_COLUMN=product_category_id
# CATALOG_PRODUCT_TYPE_TABLE=product_type
# CATALOG_DEFAULT_PRODUCT_TYPE_ID=
# CATALOG_PRODUCT_SALES_CHANNEL_LINK_TABLE=product_sales_channel
# CATALOG_SALES_CHANNEL_TABLE=sales_channel
# CATALOG_PRODUCT_TAG_LINK_TABLE=product_tags
# CATALOG_PRODUCT_TAG_TABLE=product_tag
# CATALOG_PRODUCT_TAG_ID_COLUMN=id
# CATALOG_PRODUCT_TAG_VALUE_COLUMN=value
# CATALOG_PRODUCT_TAG_LINK_PRODUCT_COLUMN=product_id
# CATALOG_PRODUCT_TAG_LINK_TAG_COLUMN=product_tag_id
