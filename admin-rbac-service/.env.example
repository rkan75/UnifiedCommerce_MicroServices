# Admin RBAC Service - same DB as Medusa (user, invite, rbac_role, admin_credential, etc.)
SERVER_PORT=8088
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/grocery_store
SPRING_DATASOURCE_USERNAME=grocery_app
SPRING_DATASOURCE_PASSWORD=your_password

# Must match store backend JWT_SECRET so backend can validate the admin cookie
ADMIN_JWT_SECRET=43c165c91c29d4762ea3e3171056e933d65fc7381a3cf8036f7a126cebf3e1fb

JWT_SECRET=43c165c91c29d4762ea3e3171056e933d65fc7381a3cf8036f7a126cebf3e1fb

ADMIN_CREDENTIAL_TABLE=admin_credential

RBAC_TABLE_SCHEMA=public
RBAC_INVITE_TABLE=invite
RBAC_ROLE_TABLE=rbac_role
RBAC_POLICY_TABLE=rbac_policy
RBAC_USER_ROLE_LINK_TABLE=user_rbac_role
RBAC_ROLE_POLICY_LINK_TABLE=rbac_role_rbac_policy

