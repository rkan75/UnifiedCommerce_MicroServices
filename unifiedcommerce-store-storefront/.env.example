# Medusa backend URL. Update CORS on the server when changing.
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key (required). Copy from your running backend:
# 1. Open Medusa Admin (e.g. http://localhost:9000/app)
# 2. Settings → Publishable API Keys → copy a key (starts with pk_)
# 3. Paste below and restart the storefront (npm run dev / yarn dev)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_f8e261468637babef6c09293ce362076755f516c3fd5fb40355e8b90c964eb42

# Storefront base URL.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region when geo is unavailable (ISO-2 lowercase).
NEXT_PUBLIC_DEFAULT_REGION=us

# Stripe (optional)
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# Next.js on-demand revalidation
REVALIDATE_SECRET=

# Medusa Cloud image optimization (optional)
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

# --- Algolia (Medusa Algolia search plugin) ---
# Use Search-Only API Key here (safe for client). Get from Algolia Dashboard → API Keys.
# When set, header search uses Algolia; otherwise falls back to store page search.
NEXT_PUBLIC_ALGOLIA_APP_ID= 8UPZHDU2DT
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=589234ab00b84d5ec9fcc79f1ff48658    
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=products
